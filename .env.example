# ========================================================
# Cấu hình chung cho toàn bộ Test Suite Nhóm 4
# Sao chép file này thành .env và chỉnh sửa theo cấu hình máy của bạn
# ========================================================

# URL website nopCommerce (VD: http://localhost, http://localhost:8080, http://127.0.0.1:8081)
BASE_URL=http://localhost

# Tài khoản Admin nopCommerce
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=Admin@123

# Cho phép chạy các test case thao tác ghi/sửa/xóa CSDL (CRUD)
RUN_MUTATING_TESTS=true

